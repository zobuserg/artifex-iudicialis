# Copiar este archivo a ".env" en la misma carpeta y pegar tu clave real.
# El archivo .env no debe subirse a git (está en .gitignore).
#
# Obtener clave: https://console.anthropic.com/

ANTHROPIC_API_KEY=sk-ant-api03-reemplazar-con-tu-clave

# Modelo API para GENERAR resoluciones e ITERACIÓN (Messages API). Por defecto se intenta Opus 4.7 y si falla, Sonnet 4.6.
# Una sola id, o lista separada por coma (orden de fallback):
# ADIUTOR_CLAUDE_RESOLUTION_MODEL=claude-opus-4-7
# ADIUTOR_CLAUDE_RESOLUTION_MODEL=claude-opus-4-7,claude-sonnet-4-6
#
# Máximo de tokens de SALIDA por generación principal, continuación o iteración íntegra (predeterminado 26000).
# Si el auto se cortaba en mitad (~16k antes), puede subir (p.ej. 32000 hasta 64000 según modelo / cuenta).
# ADIUTOR_CLAUDE_RESOLUTION_MAX_TOKENS=32000

# Generar resolución: además del texto extraído en Mac (pdfplumber/OCR en el prompt), los PDF del
# expediente y bibliografía pueden enviarse como bloques document nativos en Messages API.
# Desactivar solo el envío por API (se mantiene la extracción local en el prompt):
# ADIUTOR_API_PDF_ATTACH=0
# Cupo total aproximado para esos adjuntos en la petición (base64), en MB (predeterminado 22).
# ADIUTOR_API_PDF_MAX_TOTAL_MB=22
# Máximo de archivos PDF por petición (predeterminado 20; tope interno 50).
# ADIUTOR_API_PDF_MAX_FILES=20
#
# Prototipo: si ADIUTOR_API_PDF_ATTACH=0, enviar las N primeras páginas del primer PDF como imágenes PNG
# (alto coste en tokens; no combinar con adjunto PDF nativo). 0 = desactivado.
# ADIUTOR_VISION_PDF_PAGES=0
# DPI del render para ese prototipo (72–200; predeterminado 120).
# ADIUTOR_VISION_PDF_DPI=120

# Apariencia: soft (oscuro azulado, predeterminado) | light | dark (alto contraste)
# ADIUTOR_THEME=soft

# «Consultar wiki»: por defecto modo rápido (no recorre todos los expedientes en fuentes/).
# Solo si necesita PDF/audio de cada caso en ese chat:
# ADIUTOR_WIKI_SCAN_FUENTES=1
#
# Ingest wiki (corpus / bibliografía → fichas en 02_wiki): si la lectura local del PDF falla,
# reintenta con Haiku leyendo el PDF como documento nativo en la API. Desactivar:
# ADIUTOR_WIKI_INGEST_PDF_NATIVE=0
# Tamaño máximo de ese PDF por archivo en MB (predeterminado 20; tope interno 32).
# ADIUTOR_WIKI_PDF_NATIVE_MAX_MB=20
#
# Para incluir OCR/extractos pesados de 01_raw/bibliografia en el mismo chat:
# ADIUTOR_WIKI_CHAT_INCLUDE_DOCS=1
#
# Límite de fichas .md extra por zona (juris/casos) antes de omitir (~60–400; predeterminado 180):
# ADIUTOR_WIKI_MD_MAX_FILES=180
#
# Máximo de archivos .md visitados por rglob en cada zona (muchas vacías — predeterminado ~4000 o 24 × MD_MAX_FILES):
# ADIUTOR_WIKI_MD_MAX_TRAVERSAL=4000
#
# Transcripción Whisper automática al generar con Claude (no aplica igual en Consultar wiki)
# ADIUTOR_WHISPER_AUTO=1

# ADIUTOR_OCR=0
# ADIUTOR_OCR_MAX_PAGES=80
# ADIUTOR_OCR_ZOOM=1.5
# ADIUTOR_OCR_DPI=200
# Si abre la app desde el icono y OCR falla pese a tener Tesseract: ruta explícita (macOS Apple Silicon).
# ADIUTOR_TESSERACT_CMD=/opt/homebrew/bin/tesseract
# Umbral de «palabras» (tokens) para aceptar solo texto nativo del PDF sin pasar a OCR (predeterminado 18).
# Baje a 12 si el PDF tiene poco texto seleccionable pero no es escaneo puro.
# ADIUTOR_PDF_NATIVE_MIN_WORDS=12
#
# Junto a expediente.pdf puede guardar expediente.txt o expediente.md (≥80 caracteres): se fusionan al leer el PDF.
# ADIUTOR_CORPUS_WORKERS=3
#
# Riqueza del ingest: corpus decisorio/clasificado, doctrina (bibliografía) y ficha tras resolución (Haiku).
# Corpus: el modelo clasifica decisorio vs doctrina; en decisorio prioriza ratio decidendi sobre relato ornamental.
# Doctrina: mismas tres variables aplican al ingest desde 01_raw/bibliografia/.
# ADIUTOR_CORPUS_FICHA_INPUT_CHARS=48000
# ADIUTOR_CORPUS_FICHA_OUTPUT_TOKENS=4096
# ADIUTOR_CORPUS_FICHA_TARGET_WORDS=900
#
# Tamaño máx. de caracteres leídos por archivo en `01_raw/bibliografia/global/` antes del filtro Haiku + regex
# (predeterminado 80000; puede subirse si los artículos citados están al final del PDF).
# ADIUTOR_GLOBAL_CODE_MAX_CHARS=120000
